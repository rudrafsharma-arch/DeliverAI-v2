{
  "id": "blueprint",
  "name": "Business Blueprint",
  "description": "Generates a complete Business Blueprint covering As-Is, To-Be, gap analysis, RACI and integration points",
  "version": "1.0.0",
  "phase": "explore",
  "category": "documentation",
  "projectTypes": [
    "s4hana-public",
    "s4hana-private",
    "s4hana-onprem",
    "ecc",
    "btp",
    "oracle",
    "workday",
    "salesforce",
    "custom"
  ],
  "icon": "📋",
  "color": "#1a5c1a",
  "inputs": {
    "required": [
      "projectName",
      "processName",
      "description"
    ],
    "optional": [
      "client",
      "sapSystem",
      "module",
      "preparedBy",
      "version"
    ],
    "fromAgents": [],
    "fromContext": [
      "projectName",
      "client",
      "systemDetails"
    ]
  },
  "outputs": {
    "produces": "blueprint_{projectName}_{version}.html",
    "contextKeys": [
      "process",
      "asIs",
      "toBe",
      "gaps",
      "integrations",
      "roles"
    ]
  },
  "suggests": [
    "functional-spec",
    "interface-design",
    "test-scripts"
  ],
  "model": "claude-sonnet-4-6",
  "maxTokens": 8000,
  "knowledge": [
    "sap/activate-methodology.md",
    "sap/btp-integration-best-practices.md"
  ],
  "tags": [
    "document",
    "process",
    "blueprint",
    "explore"
  ],
  "requiredConnections": [
    "claude"
  ],
  "connectionDetails": [
    {
      "label": "Claude Code CLI",
      "icon": "🤖",
      "required": true,
      "envKeys": [
        "GIT_BASH_PATH",
        "CLAUDE_PATH",
        "AI_ENGINE"
      ]
    }
  ]
}