    },
    {
      "name": "priceTolerance",
      "label": "Price variance tolerance (%)",
      "type": "number",
      "required": true,
      "placeholder": "2"
    },
    {
      "name": "slaHours",
      "label": "Buyer task SLA (hours)",
      "type": "number",
